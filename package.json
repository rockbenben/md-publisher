{
  "name": "md-publisher",
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "批量发布 Markdown 文章到多个内容平台",
  "keywords": [
    "markdown",
    "publisher",
    "batch",
    "wechat",
    "zhihu",
    "sspai",
    "juejin",
    "smzdm"
  ],
  "license": "MIT",
  "author": {
    "name": "rockbenben",
    "email": "qingwhat@gmail.com",
    "url": "https://github.com/rockbenben"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockbenben/md-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/rockbenben/md-publisher/issues"
  },
  "homepage": "https://github.com/rockbenben/md-publisher",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "publish": "node src/index.js",
    "gui": "node src/gui.js",
    "web:install": "npm --prefix web install",
    "web:ci": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "electron": "electron .",
    "electron:dev": "npm run web:build && electron .",
    "dist": "npm run web:build && electron-builder",
    "test:e2e": "node e2e/electron-smoke.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.1",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "js-yaml": "^5.5.0",
    "marked": "^18.0.5",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}

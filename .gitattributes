# Auto detect text files and perform LF normalization
* text=auto

# Vite rewrites most of the HTML entry point but passes untouched elements
# through verbatim, line endings included. Under * text=auto alone a Windows
# checkout hands web/index.html CRLF; one CRLF survives into the built
# src/public/index.html, and the pin below then reports that file as
# permanently modified. Pin the input to LF so the emitted output is LF.
# Only the entry point needs this: do NOT glob web/** (web/public/** holds
# .ico/.png assets copied byte-for-byte) or src/public/** (same reason).
web/index.html text eol=lf
src/public/index.html text eol=lf

# Bundled binaries must never be eol-normalized.
*.woff  binary
*.woff2 binary
*.png   binary
*.ico   binary
